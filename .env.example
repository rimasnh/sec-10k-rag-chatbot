# Local overrides for docker-compose.yml.
# Copy this file to .env and adjust values as needed.

OLLAMA_CHAT_MODEL=llama3.2:1b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Required only if you ingest from Azure Blob storage.
# docker compose reads this during interpolation from .env or your shell.
AZURE_BLOB_CONNECTION_STRING=your-azure-blob-connection-string
AZURE_BLOB_CONTAINER_NAME=datafiles

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://127.0.0.1:5173