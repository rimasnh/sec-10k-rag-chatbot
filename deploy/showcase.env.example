# Public URL where the frontend will be reachable.
FRONTEND_PORT=5173

# Backend model provider. Point this at a hosted Ollama instance or compatible gateway.
OLLAMA_BASE_URL=http://your-ollama-host:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Qdrant can stay inside docker-compose unless you are using a managed instance.
QDRANT_PORT=6333
QDRANT_COLLECTION=sec_10k_sections

# Frontend will call /api by default when served from the same host.
VITE_API_BASE_URL=/api

# Comma-separated list for the browser origin(s) that may call the backend directly.
CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-showcase-domain.example

# Optional: ingest automatically on startup after the data volume is mounted.
AUTO_INGEST=false
